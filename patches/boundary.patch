+static void md4w_clear_refs(MD4W_SESSION* s) {
+    md_free_ref_def_hashtable(&s->refs);
+    md_free_ref_defs(&s->refs);
+    free(s->snapshot);
+    memset(s, 0, sizeof(*s));
