+/* A streamed paragraph made of a pipe row, and perhaps the start of its
+ * delimiter row, shows as the table header it is about to become. */
+static void
+md4w_table_header(MD_CTX* ctx)
+{
+    MD_BLOCK* block = ctx->current_block;
+    const MD_LINE* lines;
+    OFF off, end;
+
+    if(!(ctx->parser.flags & MD4W_STREAMING) || !(ctx->parser.flags & MD_FLAG_TABLES) ||
+       block == NULL || block->type != MD_BLOCK_P || block->n_lines > 2)
+        return;
+    lines = (const MD_LINE*) (block + 1);
+    if(CH(lines[0].beg) != _T('|'))
+        return;
+
+    end = lines[block->n_lines-1].end;
+    while(end < ctx->size && ISWHITESPACE(end)) end++;
+    if(end < ctx->size && ISNEWLINE(end)) end++;
+    if(end != ctx->size)
+        return;
+
+    if(block->n_lines == 2) {
+        for(off = lines[1].beg; off < lines[1].end; off++)
+            if(!ISANYOF(off, _T("|:- \t")))
+                return;
+    }
+
+    for(off = lines[0].beg; off < lines[0].end && ISANYOF(off, _T("| \t")); off++);
+    if(off == lines[0].end)
+        return;
+
+    /* The block is the last one, so its unfinished delimiter row is the last line pushed. */
+    ctx->n_block_bytes -= (block->n_lines - 1) * sizeof(MD_LINE);
+    block->n_lines = 1;
+    block->type = MD_BLOCK_TABLE;
 }
 
