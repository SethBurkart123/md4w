+#include "session.h"
+
+struct MD4W_SESSION {
+    MD_CTX refs;
+    CHAR* snapshot;
+    unsigned prefix_cost;
+    unsigned budget;
+    int provisional;
+    int exhausted;
+};
+
+static void md4w_clear_refs(MD4W_SESSION* s) {
+    md_free_ref_def_hashtable(&s->refs);
+    md_free_ref_defs(&s->refs);
+    free(s->snapshot);
+    memset(s, 0, sizeof(*s));
+}
+
+MD4W_SESSION* md4w_open(void) { MD4W_SESSION* s = malloc(sizeof(*s)); if(s) memset(s, 0, sizeof(*s)); return s; }
+void md4w_close(MD4W_SESSION* s) { md4w_clear_refs(s); free(s); }
