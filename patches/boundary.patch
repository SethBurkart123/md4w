 static int
+md4w_inline_range(MD_CTX* parent, OFF beg, OFF end)
+{
+    MD_LINE line = { beg, end };
+    MD_CTX ctx = {0};
+    int ret, i;
+    if(beg == end) return 0;
+    if(parent->rule_depth >= 16)
+        return parent->parser.text(MD_TEXT_NORMAL, parent->text+beg, end-beg, parent->userdata);
+    ctx.text = parent->text;
+    ctx.size = end;
+    ctx.parser = parent->parser;
+    ctx.parser.flags &= ~MD4W_STREAMING;
+    ctx.userdata = parent->userdata;
+    ctx.rule_depth = parent->rule_depth + 1;
+    ctx.saved_defs = parent->saved_defs;
+    ctx.ref_defs = parent->ref_defs;
+    ctx.n_ref_defs = parent->n_ref_defs;
+    ctx.ref_def_hashtable = parent->ref_def_hashtable;
+    ctx.ref_def_hashtable_size = parent->ref_def_hashtable_size;
+    ctx.max_ref_def_output = parent->max_ref_def_output;
+    memcpy(ctx.mark_char_map, parent->mark_char_map, sizeof(ctx.mark_char_map));
+    for(i = 0; i < (int)SIZEOF_ARRAY(ctx.opener_stacks); i++) ctx.opener_stacks[i].top = -1;
+    ctx.ptr_stack.top = ctx.unresolved_link_head = ctx.unresolved_link_tail = -1;
+    ctx.table_cell_boundaries_head = -1;
+    ret = md_process_normal_block_contents(&ctx, &line, 1);
+    parent->max_ref_def_output = ctx.max_ref_def_output;
+    parent->budget_exhausted |= ctx.budget_exhausted;
+    free(ctx.marks);
+    free(ctx.buffer);
+    return ret;
+}
